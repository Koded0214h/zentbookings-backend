# ---- Runtime ----
PROD=false

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://zent:zent@localhost:5432/zent

# ---- Auth / JWT ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ---- Frontend / CORS ----
FRONTEND_BASE_URL=https://zentbookings.com
CORS_ORIGINS=https://zentbookings.com,https://www.zentbookings.com,http://localhost:5173,http://localhost:3000
ALLOWED_OAUTH_REDIRECT_HOSTS=zentbookings.com,www.zentbookings.com,localhost,127.0.0.1

# ---- Google OAuth (paste keys from GCP) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# "select_account consent" forces the consent/branding screen every sign-in;
# drop "consent" for production once branding is confirmed.
GOOGLE_OAUTH_PROMPT=select_account consent

# ---- Apple OAuth (optional) ----
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/api/auth/apple/callback

# ---- SMTP (required when PROD=true; console/log sender otherwise) ----
# SMTP_SECURITY: "starttls" (port 587), "ssl" (port 465), or "none"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Zent <no-reply@zentbookings.com>

# ---- Cloudinary (property media uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=zent/properties

# ---- Rate limiting (count/seconds, per client IP) ----
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/60
REGISTER_RATE_LIMIT=5/60
FORGOT_PASSWORD_RATE_LIMIT=5/300
LIST_RATE_LIMIT=300/60
TOUR_CREATE_RATE_LIMIT=5/300
TOUR_LOOKUP_RATE_LIMIT=10/300

# ---- Catalogue response caching ----
PROPERTIES_CACHE_MAX_AGE=60

# ---- Background maintenance ----
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=3600
MEDIA_SWEEP_ENABLED=true
MEDIA_SWEEP_GRACE_SECONDS=86400
